# Copy to .env and adjust as needed.

# --- Database ---------------------------------------------------------------
# Default: zero-config local SQLite file.
DATABASE_URL=sqlite:///./task_manager.db
#
# Local PostgreSQL (e.g. the server pgAdmin connects to). Format:
#   postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/task_manager

# --- Auth -------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS -------------------------------------------------------------------
# JSON array of allowed browser origins (the Vite dev server / deployed frontend)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Copy to .env.local for local overrides, or set in your host's build settings.
#
# Leave empty for local development — the Vite dev server proxies /api to the
# backend on localhost:8000 (see vite.config.ts).
#
# For a deployed build, set this to the backend's public origin (no trailing slash):
#   VITE_API_BASE_URL=https://your-backend.onrender.com
VITE_API_BASE_URL=

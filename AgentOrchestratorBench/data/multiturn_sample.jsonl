# tools are filled from the backend's defaults when omitted. See docs/multi-turn.md.
{"id": "ship_order", "backend": "records", "user_turns": ["Mark Alice's order as shipped."], "initial_state": {"records": {"r1": {"name": "Alice order", "status": "pending"}, "r2": {"name": "Bob order", "status": "pending"}}}, "goal": {"field_equals": [{"record": "r1", "field": "status", "value": "shipped"}]}}
